// Prisma schema for AI Career Coach
// Local persistent SQLite provider for zero-configuration development
// A dedicated PostgreSQL schema is also maintained in schema.postgresql.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(cuid())
  name                 String
  email                String             @unique
  passwordHash         String
  githubUsername       String?
  targetRole           String             @default("Full Stack Developer")
  experienceLevel      String             @default("Student")
  careerReadinessScore Int                @default(80)
  plan                 String             @default("pro")
  avatarUrl            String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  repositories         GitHubRepository[]
  jobPostings          JobPosting[]
  assessments          Assessment[]

  @@index([email])
}

model GitHubRepository {
  id               String               @id @default(cuid())
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubRepoId     String?
  name             String
  owner            String
  description      String?
  repoUrl          String
  defaultBranch    String               @default("main")
  latestCommitSha  String?
  lastScanTimestamp DateTime?
  webhookStatus    String               @default("inactive") // inactive, active, pending, failed
  language         String               @default("TypeScript")
  stars            Int                  @default(0)
  forks            Int                  @default(0)
  openIssues       Int                  @default(0)
  codeQualityScore Int                  @default(75)
  detectedSkills   String               @default("[]") // JSON string array
  aiAnalysisStatus String               @default("pending") // pending, analyzed, needs_reassessment
  insights         String               @default("[]") // JSON string array
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  scans            RepositoryScan[]
  webhookEvents    GitHubWebhookEvent[]

  @@index([userId])
  @@index([name])
}

model JobPosting {
  id              String           @id @default(cuid())
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  title           String
  company         String
  description     String
  sourceUrl       String?
  sourceType      String           @default("manual") // url, manual, curated
  matchScore      Int              @default(75)
  isRemote        Boolean          @default(false)
  type            String           @default("Full-time") // Full-time, Internship, Contract, Part-time
  location        String           @default("Remote")
  salary          String           @default("$90,000 - $120,000")
  requiredSkills  String           @default("[]") // JSON string array
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  requirements    JobRequirement[]
  assessments     Assessment[]

  @@index([userId])
  @@index([title])
}

model JobRequirement {
  id              String            @id @default(cuid())
  jobId           String
  job             JobPosting        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  requiredSkill   String
  description     String
  importance      String            @default("Critical") // Critical, Recommended, Bonus
  sourceExcerpt   String?
  sourceReference String?
  createdAt       DateTime          @default(now())

  skillAssessments SkillAssessment[]

  @@index([jobId])
  @@index([requiredSkill])
}

model RepositoryScan {
  id               String         @id @default(cuid())
  repositoryId     String
  repository       GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  commitSha        String
  scanStatus       String         @default("completed") // queued, scanning, completed, failed
  scanTimestamp    DateTime       @default(now())
  errorInfo        String?
  fileTreeSummary  String?        // JSON string of inspected file paths
  detectedTech     String         @default("[]") // JSON string array
  createdAt        DateTime       @default(now())

  evidences        CodeEvidence[]

  @@index([repositoryId])
  @@index([commitSha])
}

model CodeEvidence {
  id                  String         @id @default(cuid())
  scanId              String
  scan                RepositoryScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  skill               String
  filePath            String
  startLine           Int            @default(1)
  endLine             Int            @default(1)
  commitSha           String
  evidenceDescription String
  confidence          Int            @default(85) // 0 - 100
  codeSnippet         String?
  createdAt           DateTime       @default(now())

  @@index([scanId])
  @@index([skill])
  @@index([commitSha])
}

model Assessment {
  id                      String            @id @default(cuid())
  userId                  String
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId                   String?
  job                     JobPosting?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  overallScore            Int
  previousAssessmentId    String?
  scoreChangeFromPrevious Int               @default(0)
  targetRole              String
  reposAnalyzedCount      Int               @default(1)
  primaryStrengths        String            @default("[]") // JSON string array
  keyGapAreas             String            @default("[]") // JSON string array
  summaryFeedback         String
  createdAt               DateTime          @default(now())

  skillAssessments        SkillAssessment[]

  @@index([userId])
  @@index([jobId])
}

model SkillAssessment {
  id                 String          @id @default(cuid())
  assessmentId       String
  assessment         Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  requirementId      String?
  requirement        JobRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  skillName          String
  category           String          @default("Backend")
  score              Int             @default(70)
  targetLevel        Int             @default(85)
  evidenceStatus     String          @default("Partial Evidence") // Strong Evidence, Partial Evidence, No Evidence, Not Evaluated
  explanation        String
  recommendation     String
  supportingFilePath String?
  codeReference      String?
  actionItems        String          @default("[]") // JSON string array
  createdAt          DateTime        @default(now())

  @@index([assessmentId])
  @@index([skillName])
}

model GitHubWebhookEvent {
  id               String            @id @default(cuid())
  deliveryId       String            @unique
  repositoryId     String?
  repository       GitHubRepository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  eventType        String            @default("push")
  commitSha        String?
  processingStatus String            @default("received") // received, processing, processed, failed
  payload          String
  errorInfo        String?
  createdAt        DateTime          @default(now())

  @@index([deliveryId])
  @@index([repositoryId])
}
