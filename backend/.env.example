# AI Career Coach Backend Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database URL
# For local persistent zero-configuration development:
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/aicareercoach?schema=public"

# Authentication Secrets
JWT_SECRET=super-secret-jwt-dev-key-change-in-prod-2026
JWT_EXPIRES_IN=7d

# GitHub Integration
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
# Optional GitHub Personal Access Token to avoid public rate-limiting (60 req/hr -> 5000 req/hr)
GITHUB_TOKEN=

# AI & Additional Integrations
OPENAI_API_KEY=your_openai_or_gemini_api_key_here
STRIPE_SECRET_KEY=your_stripe_test_secret_key_here
